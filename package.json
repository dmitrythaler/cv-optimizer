{
  "name": "cv-optimizer",
  "version": "0.5.0",
  "description": "Tailors a CV to a job description, then grades its own output until it passes.",
  "keywords": [
    "ats",
    "cli",
    "cv",
    "llm",
    "resume"
  ],
  "homepage": "https://github.com/dmitrythaler/cv-optimizer#readme",
  "bugs": "https://github.com/dmitrythaler/cv-optimizer/issues",
  "license": "WTFPL",
  "author": "Dmitry Thaler <dmitry@thaler.dev> (https://thaler.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmitrythaler/cv-optimizer.git"
  },
  "bin": {
    "cv-optimizer": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "start": "node --env-file=.env dist/cli.js",
    "model:pull": "node --env-file=.env dist/cli.js pull-model",
    "dev": "node --env-file=.env --watch src/cli.ts",
    "test": "node --test test/*.test.ts",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check ."
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.21",
    "@ai-sdk/google": "^4.0.33",
    "@huggingface/transformers": "^4.2.0",
    "ai": "^7.0.51",
    "playwright": "^1.62.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "oxfmt": "^0.62.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
