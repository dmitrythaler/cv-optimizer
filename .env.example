# Chat models (remote API), split by cost.
#   pro    - the careful one. HallucinationChecker uses it.
#   flash  - the cheap one. AiGeneratedChecker uses it.
#   vision - must accept images. VisionChecker uses it.
# Names must exist. DeepSeek /v1/models lists only these two.
PRO_MODEL=deepseek/deepseek-v4-pro
FLASH_MODEL=deepseek/deepseek-v4-flash
DEEPSEEK_API_KEY=

# VISION_MODEL needs a provider that accepts images. DeepSeek does NOT.
# Tested 2026-08-04: its API rejects every image content-part shape with
# "unknown variant `image_url`, expected `text`", for every model id. The
# DeepSeek app has a vision mode; the public API does not.
# Gemini works. Verified: it named the colour of a test image correctly.
VISION_MODEL=gemini/gemini-3.5-flash
GEMINI_API_KEY=

# Embeddings run LOCALLY in a worker thread. No API, no key.
# Hugging Face repo id of an ONNX-exported model.
#   Xenova/bge-m3                multilingual + 8192 ctx  (some JDs are Polish)
#   nomic-ai/nomic-embed-text-v1.5  English, 8192 ctx, smaller
# Verified 2026-08-04: both repo ids exist and ship ONNX weights.
EMBEDDING_MODEL=Xenova/bge-m3
EMBEDDING_DIMENSIONS=0
EMBEDDING_MAX_INPUT_TOKENS=8192

MAX_ITERATIONS=3
LOG_LEVEL=info

# Name of the CV file inside the run folder.
#
# One run writes one folder, named {date}-{time}-{company}-{position}. The
# folder name is fixed. This setting controls only the CV file inside it,
# because that is the name a recruiter sees once the file leaves the folder.
#
# Static text plus these placeholders:
#   {date}      20260805
#   {time}      0912
#   {company}   link_group        (alias: {company_slug})
#   {position}  full_stack_engineer   (alias: {position_slug})
#   {lang}      en
#
# An unknown placeholder STOPS the run. It never ships as literal text.
# ".pdf" is appended if the template does not end with it.
CV_NAME_TEMPLATE=John.Dow.CV.{company}.{position}.pdf

# Lenient prompts and bounds. Massively relaxes the fabrication checks.
# Use with caution.
NO_SHAME=false

# Filter thresholds.
THRESHOLD_KEYWORD=0.25
THRESHOLD_HALLUCINATION=0.9
THRESHOLD_AI_GENERATED=0.4
THRESHOLD_VISION=0.7

# THRESHOLD_VECTOR is model-specific and MUST be measured, never guessed.
# Measured 2026-08-04 for Xenova/bge-m3 @ 1024 dims with `cv-optimizer
# calibrate-vector`: real jobs 0.79-0.90, off-topic controls 0.50-0.54,
# midpoint 0.67. If you change EMBEDDING_MODEL, re-run calibrate-vector -
# this number does not transfer. The code default is NaN so an unmeasured
# threshold fails loudly instead of silently passing everything.
THRESHOLD_VECTOR=0.67
