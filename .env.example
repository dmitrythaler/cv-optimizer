# Chat model (remote API).
CHAT_MODEL=deepseek/deepseek-chat
DEEPSEEK_API_KEY=

# Embeddings run LOCALLY in a worker thread. No API, no key.
# Hugging Face repo id of an ONNX-exported model.
#   Xenova/bge-m3                multilingual + 8192 ctx  (some JDs are Polish)
#   Xenova/nomic-embed-text-v1.5 English, 8192 ctx, smaller
# Verify the exact repo id exists before first run.
EMBEDDING_MODEL=Xenova/bge-m3
EMBEDDING_DIMENSIONS=0
EMBEDDING_MAX_INPUT_TOKENS=8192

MAX_ITERATIONS=3
LOG_LEVEL=info

# Filter thresholds.
THRESHOLD_KEYWORD=0.25
THRESHOLD_HALLUCINATION=0.9
THRESHOLD_AI_GENERATED=0.4
THRESHOLD_VISION=0.7

# THRESHOLD_VECTOR is deliberately unset: it MUST be measured against whichever
# local model you choose. The Python value (0.55) was calibrated on hosted
# gemini-embedding-001 and does not transfer. See docs/porting-notes.md.
# THRESHOLD_VECTOR=
